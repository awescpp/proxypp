{
  "type": "commonjs",
  "scripts": {
    "co": "cz",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "configure": "node scripts/cmake-presets.mjs configure -p debug",
    "build": "node scripts/cmake-presets.mjs build -p debug",
    "configure-build": "node scripts/cmake-presets.mjs configure-build -p debug",
    "unittest": "node scripts/cmake-presets.mjs test -p debug",
    "sanitize": "node scripts/cmake-presets.mjs workflow -p sanitizers",
    "test:e2e": "vitest run --config vitest.config.ts",
    "test:all": "pnpm unittest && pnpm test:e2e",
    "test:e2e:watch": "vitest --config vitest.config.ts",
    "coverage": "node scripts/coverage.mjs",
    "format": "prettier --write \"e2e/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"e2e/**/*.ts\" \"*.ts\" \"*.json\" \"*.md\"",
    "prepare": "simple-git-hooks",
    "lint:commit": "commitlint --edit",
    "docs:dev": "pnpm --ignore-workspace --dir docs dev",
    "docs:build": "pnpm --ignore-workspace --dir docs build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "axios": "^1.17.0",
    "commander": "^15.0.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.1",
    "execa": "^9.6.1",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  },
  "packageManager": "pnpm@11.1.2"
}
